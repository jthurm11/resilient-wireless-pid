      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB_Flux" },
          "query": "from(bucket: \"wireless_pid_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"control_telemetry\")\n  |> keep(columns: [\"_time\", \"environment\"])\n  |> group()\n  |> sort(columns: [\"_time\"], desc: false)\n  |> last(column: \"environment\")\n  |> rename(columns: {environment: \"_value\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {

    {
      "collapsed": false,
      "gridPos": { "h": 9, "w": 21, "x": 0, "y": 3 },
      "id": 1,
      "title": "Process Variable (PV) vs Setpoint (SP)",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "InfluxDB_Flux" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "never"
          },
          "displayName": "${__series.name}"
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*SP:.*" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "pink" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB_Flux" },
          "query": "from(bucket: \"wireless_pid_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"control_telemetry\")\n  |> filter(fn: (r) => r[\"_field\"] == \"process_variable\" or r[\"_field\"] == \"setpoint\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({\n      _time: r._time,\n      _value: r._value,\n      _field: if r._field == \"process_variable\" then \"PV: \" + r.trial_id else \"SP: \" + r.trial_id\n  }))\n  |> group(columns: [\"_field\"])\n  |> yield(name: \"tracking\")"
        }
      ]
    },
